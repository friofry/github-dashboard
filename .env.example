# Copy to .env (git-ignored). Everything is optional.

# Only show pull requests from these organizations. Empty = all repositories.
GITHUB_ORGS=

# Hide activity from these logins, e.g. CI accounts. Bots are always hidden.
IGNORED_LOGINS=

# App identity and signing. Only needed to run on a real device or to distribute.
BUNDLE_ID=
DEVELOPMENT_TEAM=

# iOS Simulator only: token passed to the app at launch. Empty = use `gh auth token`.
GH_TOKEN=

# Simulator used by run_ios.sh. Empty = first available iPhone.
IOS_SIMULATOR=
