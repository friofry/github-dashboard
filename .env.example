# Copy to .env (git-ignored). Everything is optional.

# Only show pull requests from these organizations or users. Empty = all repositories.
GITHUB_ORGS=

# Hide activity from these logins, e.g. CI accounts. Bots are always hidden.
IGNORED_LOGINS=

# App identity and signing. Only needed to run on a real device or to distribute.
BUNDLE_ID=
DEVELOPMENT_TEAM=

# There is no GH_TOKEN here on purpose: a token in a plain-text file leaks too easily.
# run_ios.sh hands the simulator `gh auth token`, or GH_TOKEN if you export it in your shell.

# Simulator used by run_ios.sh. Empty = first available iPhone.
IOS_SIMULATOR=
